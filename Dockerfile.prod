# syntax=docker/dockerfile:1
# ==============================================================================
# PRF Frontend - Production Dockerfile
# ==============================================================================
# Multi-stage build: Node.js builds Angular, nginx serves static files
# Note: Uses Angular 19 browser builder which outputs to dist/<project> (no /browser)
# ==============================================================================

# Stage 1: Build the Angular application
FROM node:20-alpine AS builder

WORKDIR /project

# ---------------------------------------------------------------------------
# ci-9 — OFFLINE-FIRST (his ask 2026-09-19). Two layers of reuse, both optional:
#   1. --mount=type=cache,target=/root/.npm — npm's own package cache, kept by
#      BuildKit between builds on the same daemon. With --prefer-offline npm
#      uses what is there and only asks the registry for what is genuinely new.
#   2. NPM_CONFIG_REGISTRY — tier two's verdaccio proxy, passed by the pipeline
#      only when it answers (polari-jenkins/cache.sh build-args). Unset = npmjs.
# An empty cache still builds, over the network. Nothing here is a precondition.
#
# `npm ci` rather than `npm install`: package-lock.json is present and in sync,
# and ci is both faster and reproducible. It FAILS LOUDLY on a lock that has
# drifted from package.json — the fix is `npm install` on a developer's machine
# and committing the lock, not papering over it in the image.
# ---------------------------------------------------------------------------
ARG NPM_CONFIG_REGISTRY=

# Install Angular CLI globally (matching project version)
RUN --mount=type=cache,target=/root/.npm \
    npm install -g --prefer-offline --no-audit --no-fund @angular/cli@19.2.0

# Copy package files first for better layer caching
COPY package*.json ./

# Install dependencies
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --no-audit --no-fund

# Copy source code
COPY . .

# Build for production
RUN ng build --configuration=production

# Stage 2: Serve with nginx (tiny footprint)
FROM nginx:alpine

# Copy custom nginx config for SPA routing
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built assets from builder stage
# Angular 19 browser builder outputs to dist/<project> (no /browser subdirectory)
COPY --from=builder /project/dist/polari-platform /usr/share/nginx/html

# Expose port 4200 to match existing proxy config
EXPOSE 4200

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
